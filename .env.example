# Set in the RunPod endpoint dashboard. Never bake credentials into the image.
MODEL_KIND=image
MODEL_ID=black-forest-labs/FLUX.1-schnell
HF_TOKEN=
HF_HOME=/runpod-volume/huggingface
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Separate video endpoint:
# MODEL_KIND=video
# MODEL_ID=Wan-AI/Wan2.1-T2V-1.3B-Diffusers
# LoRA support: uploaded adapters are cached here; Hugging Face ones use HF_HOME above.
LORA_CACHE=/runpod-volume/loras
LORA_MAX_MB=500
# FLUX 3 uses its own image (Dockerfile.flux3), a 48 GB GPU and an HF_TOKEN that accepted its license.
# PROMPT_UPSAMPLER=on
# SAFETY_THRESHOLD=0.8
# Which model family this endpoint serves: flux3, flux (gated, needs HF_TOKEN), sdxl (open; text, photo and style reference to image), klein (open; text-to-image and photo editing), wan (text-to-video), wan22 (photo-to-video, 5B) or wan22a14b (photo-to-video, 14B).
MODEL_ARCH=sdxl
